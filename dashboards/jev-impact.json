{
  "annotations": { "list": [] },
  "description": "Jev/TypeSafe impact: calls, compliance against detected quantitative claims, latency, tokens, confidence. Fed by `jev meter serve` on 127.0.0.1:8788 scraped via host.containers.internal.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["jev"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Jev Impact",
  "uid": "jev-impact",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jev calls (24h)",
      "description": "Total TypeSafe/Jev calls across all harnesses in the last 24 hours.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_calls_total[24h]))",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Compliance",
      "description": "Share of detected quantitative claims that went through Jev, over the dashboard time range.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "green", "value": 0.7 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_opportunities_total{matched=\"true\"}[$__range])) / sum(increase(jev_opportunities_total[$__range]))",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (24h)",
      "description": "Failed Jev calls (transport, API, decode, timeout, missing key).",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_calls_total{status=\"error\"}[24h]))",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Calls by harness",
      "description": "Jev call rate per harness.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness) (rate(jev_calls_total[$__rate_interval]))",
          "legendFormat": "{{harness}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Opportunities vs calls (per day)",
      "description": "Detected quantitative claims versus actual Jev calls, daily accumulation.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_opportunities_total[1d]))",
          "legendFormat": "opportunities",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        },
        {
          "refId": "B",
          "expr": "sum(increase(jev_calls_total[1d]))",
          "legendFormat": "calls",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sessions touched by Jev (per day)",
      "description": "Distinct sessions with at least one Jev call, by harness.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness) (increase(jev_sessions_with_calls_total[1d]))",
          "legendFormat": "{{harness}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Judgment latency p50 / p95",
      "description": "Jev call latency percentiles from jev_latency_seconds.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(jev_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(jev_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens by kind",
      "description": "TypeSafe input/output token rate.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(jev_tokens_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Confidence distribution",
      "description": "Answer confidence by primitive, bucketed.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (primitive, le) (rate(jev_confidence_bucket[$__rate_interval]))",
          "legendFormat": "{{primitive}} le={{le}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Outcomes (session labeling)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sessions per day by outcome",
      "description": "Labeled agent sessions, stacked by Jev-assessed outcome.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(jev_sessions_total[1d]))",
          "legendFormat": "{{outcome}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Waste patterns",
      "description": "Dominant waste pattern per labeled session (loops, truncation, retries, waiting on human).",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pattern) (increase(jev_waste_total[1d]))",
          "legendFormat": "{{pattern}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Friction distribution",
      "description": "Jev-assessed session friction, bucketed 1 (none) to 5 (severe).",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(jev_session_friction_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Jev coverage",
      "description": "Labeled sessions with at least one Jev call over all labeled sessions.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jev_labeled_sessions_with_calls_total) / sum(jev_labeled_sessions_total)",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Quality reviews (typesafe_review)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Review scores by dimension",
      "description": "Mean normalized score (0-1) per quality dimension from typesafe_review runs.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (dimension) (jev_review_score)",
          "legendFormat": "{{dimension}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Review directions",
      "description": "Direct before/after directions from reviews that supplied a previous evaluation.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (increase(jev_review_direction_total[1d]))",
          "legendFormat": "{{direction}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Agent sessions (labeled)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Session cost (labeled)",
      "description": "Agent model cost summed over the latest label of every labeled session.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 55 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jev_session_cost_usd)",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Session cost by harness",
      "description": "Labeled agent cost per harness; a step means newly labeled sessions.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 55 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (harness) (jev_session_cost_usd)",
          "legendFormat": "{{harness}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Unfinished turns and tool errors",
      "description": "Stop reasons per labeled session; length, error, and aborted mean work stopped before finishing. Tool errors are harness-reported failures.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(jev_session_stop_reasons_total[$__range]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        },
        {
          "refId": "B",
          "expr": "sum(jev_session_tool_errors_total)",
          "legendFormat": "tool errors (total)",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Failed calls by reason",
      "description": "Typed client failure per harness; unknown covers events written before error tags existed.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(jev_call_errors_total[$__range]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Noul p(yes) distribution",
      "description": "Probability distribution of noul answers, which carry no confidence field.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 71 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(jev_noul_probability_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 24,
      "type": "row",
      "title": "Meter health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 79 }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Log lines skipped",
      "description": "Malformed event-log lines the meter ignored. Anything above zero means part of the history is invisible.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 80 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jev_log_lines_total{status=\"skipped\"})",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Meter age",
      "description": "Seconds since the meter process started. Older than the last code change means it serves stale code; restart it.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 80 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - jev_meter_start_timestamp_seconds",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Log freshness",
      "description": "Seconds since the newest event. A growing number means nothing is writing to the log.",
      "datasource": { "type": "prometheus", "uid": "claude-code-prom" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 80 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - jev_last_event_timestamp_seconds",
          "datasource": { "type": "prometheus", "uid": "claude-code-prom" }
        }
      ]
    }
  ]
}
