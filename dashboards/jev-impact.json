{
  "annotations": {
    "list": []
  },
  "description": "Jev/TypeSafe impact: calls, compliance against detected quantitative claims, latency, tokens, confidence. Fed by `jev meter serve` on 127.0.0.1:8788 scraped via host.containers.internal.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["jev"],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Jev Impact",
  "uid": "jev-impact",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jev calls (24h)",
      "description": "Total TypeSafe/Jev calls across all harnesses in the last 24 hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "claude-code-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_calls_total[24h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "claude-code-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Compliance",
      "description": "Share of detected quantitative claims that went through Jev, over the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "claude-code-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(jev_opportunities_total{matched=\"true\"}[$__range])) / sum(increase(jev_opportunities_total[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "claude-code-prom"
          }
        }
      ]
    },
    {
      "id": 3,
