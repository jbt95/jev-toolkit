<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.jev.nightly</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string><HOME>/personal/jev-toolkit/scripts/nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string><HOME>/.local/share/jev/nightly.log</string>
    <key>StandardErrorPath</key>
    <string><HOME>/.local/share/jev/nightly.log</string>
  </dict>
</plist>
