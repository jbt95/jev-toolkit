<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.jev.meter</string>
    <!-- Path-free: launches the installed CLI shim, so the job survives a
         repo move. Run scripts/install.sh first. -->
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>mkdir -p "$HOME/.local/share/jev"; exec "$HOME/.local/bin/jev" meter serve &gt;&gt;"$HOME/.local/share/jev/meter.log" 2&gt;&amp;1</string>
    </array>
    <!-- launchd starts with a bare PATH: Homebrew's node must be reachable. -->
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
  </dict>
</plist>
