#!/bin/sh
# jev MCP launcher. Resolves its own symlink (installed as ~/.local/bin/jev) so the
# real repo path is found, then runs the TypeScript entrypoint with Bun.
target=$0
while [ -L "$target" ]; do
  dir=$(cd "$(dirname "$target")" && pwd)
  target=$(readlink "$target")
  case $target in
    /*) ;;
    *) target="$dir/$target" ;;
  esac
done
dir=$(cd "$(dirname "$target")" && pwd)
exec bun "$dir/../src/cli/jev.ts" "$@"
