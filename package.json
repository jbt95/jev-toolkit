{
  "name": "jev-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-first Jev/TypeSafe toolkit: a typesafe_ask judgment surface over stdio, triage question packs, one event log, Prometheus impact metrics.",
  "keywords": [
    "jev",
    "mcp",
    "omp-plugin",
    "pi-extension",
    "typesafe"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pi": {
    "extensions": [
      "./integrations/omp/index.ts"
    ],
    "skills": [
      "./integrations/omp/SKILL.md"
    ]
  }
}
