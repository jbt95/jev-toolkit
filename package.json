{
  "name": "jev-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-first Jev/TypeSafe toolkit: one typesafe_ask surface over stdio, triage question packs, one event log, Prometheus impact metrics.",
  "keywords": [
    "jev",
    "mcp",
    "typesafe"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
