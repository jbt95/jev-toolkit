{
  "name": "jev-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Jev/TypeSafe ask, candidate-ranking, and evidence-verification tools over stdio MCP.",
  "keywords": [
    "jev",
    "mcp",
    "typesafe"
  ],
  "homepage": "https://github.com/jbt95/jev-toolkit",
  "license": "MIT",
  "author": "jbt95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbt95/jev-toolkit.git"
  },
  "bin": {
    "jev": "./bin/jev"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "bun node_modules/oxfmt/bin/oxfmt .",
    "format:check": "bun node_modules/oxfmt/bin/oxfmt --check .",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun test tests --timeout=20000 && bun run test:lint-rules",
    "test:lint-rules": "node --import ./tools/oxlint/rule-tester-setup.ts --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts",
    "test:coverage": "bun test tests --timeout=20000 --coverage"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
